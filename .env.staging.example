# Deployment template only. Supply values through Render's secret manager and
# reuse only the owner-approved existing resources named in the runbook.
NIE_ENV=staging
DATABASE_URL=<existing-supabase-postgres-url>
NIE_TRUSTED_FRONTEND_ORIGINS=https://<staging-frontend-host>
FIREBASE_PROJECT_ID=<existing-firebase-project-id>
NIE_OWNER_FIREBASE_UIDS=<comma-separated-authorized-owner-uids>
NIE_OWNER_KEY=<existing-server-admin-key>

DIRECTOR_SESSION_TTL_SECONDS=1800
DIRECTOR_REALTIME_TICKET_TTL_SECONDS=45
DIRECTOR_SESSION_COOKIE_SECURE=true
DIRECTOR_SESSION_COOKIE_SAMESITE=none

# Keep disabled until credentials, PostgreSQL and the staging smoke test are ready.
NIE_ENGINEERING_MODE_ENABLED=false
NIE_ENGINEERING_OWNER_ONLY=true
NIE_ENGINEERING_ALLOWED_FIREBASE_UIDS=
NIE_ENGINEERING_STORAGE_BACKEND=supabase
SUPABASE_URL=<existing-supabase-project-url>
SUPABASE_SERVICE_ROLE_KEY=<server-side-service-role-key>
NIE_ENGINEERING_STORAGE_BUCKET=engineering-workspaces
NIE_ENGINEERING_STORAGE_TIMEOUT_SECONDS=30
NIE_ENGINEERING_RUNNER=vercel_sandbox
NIE_ENGINEERING_MAX_FILE_BYTES=1000000
NIE_ENGINEERING_MAX_WORKSPACE_BYTES=100000000
NIE_ENGINEERING_MAX_FILE_COUNT=2000
NIE_ENGINEERING_MAX_OUTPUT_BYTES=100000
NIE_ENGINEERING_MAX_PROCESSES=1
NIE_ENGINEERING_MAX_CONCURRENT_EXECUTIONS=1

# Server-side Vercel Sandbox access. Never expose these through VITE_* variables.
VERCEL_TOKEN=<existing-vercel-access-token>
VERCEL_TEAM_ID=<existing-vercel-team-id>
VERCEL_PROJECT_ID=<existing-vercel-project-id>
NIE_ENGINEERING_SANDBOX_IMAGE=vercel/sandbox/universal:latest
NIE_ENGINEERING_SANDBOX_SNAPSHOT_ID=
NIE_ENGINEERING_SANDBOX_TIMEOUT_SECONDS=300
NIE_ENGINEERING_SANDBOX_VCPUS=1
NIE_ENGINEERING_SANDBOX_MEMORY_MB=2048
NIE_ENGINEERING_SYNCHRONIZATION_TIMEOUT_SECONDS=60
NIE_ENGINEERING_CLEANUP_TIMEOUT_SECONDS=15
NIE_ENGINEERING_NETWORK_POLICY=deny_all
NIE_ENGINEERING_NETWORK_ALLOWLIST=pypi.org,files.pythonhosted.org,registry.npmjs.org

DIRECTOR_STT_PROVIDER=whisper
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_MODEL_CACHE_DIR=.cache/whisper
WHISPER_LOCAL_FILES_ONLY=true
