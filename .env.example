# Runtime classification and explicit credentialed-browser origins.
NIE_ENV=development
NIE_TRUSTED_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Human owner identity verification. Use Firebase UID values, not emails or
# frontend role claims.
FIREBASE_PROJECT_ID=
NIE_OWNER_FIREBASE_UIDS=

# Opaque server-side Director browser session controls.
DIRECTOR_SESSION_TTL_SECONDS=1800
DIRECTOR_REALTIME_TICKET_TTL_SECONDS=45
DIRECTOR_SESSION_COOKIE_SECURE=false
DIRECTOR_SESSION_COOKIE_SAMESITE=lax

# Privileged server/CLI administration only. Never expose this to Vite.
NIE_OWNER_KEY=

# Self-hosted Director speech-to-text. PyAV (installed by faster-whisper)
# supplies bundled FFmpeg libraries; no provider key is required.
DIRECTOR_STT_PROVIDER=whisper
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
# Render build command should populate this directory before the web process starts.
WHISPER_MODEL_CACHE_DIR=.cache/whisper
# Set true in production after scripts/cache_whisper_model.py succeeds at build time.
WHISPER_LOCAL_FILES_ONLY=false
WHISPER_INIT_TIMEOUT_SECONDS=45
WHISPER_TRANSCRIPTION_TIMEOUT_SECONDS=30
WHISPER_MAX_AUDIO_SECONDS=20
WHISPER_CPU_THREADS=1
WHISPER_BEAM_SIZE=1
WHISPER_TEMPERATURE=0
# Optional domain vocabulary. Keep short and validate against recorded speech.
WHISPER_INITIAL_PROMPT=
DIRECTOR_STT_MAX_AUDIO_BYTES=5242880
# Numeric-only audio ground-truth diagnostics. Off by default; never stores audio.
DIRECTOR_VOICE_DIAGNOSTICS=false
