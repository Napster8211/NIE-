# Runtime classification and explicit credentialed-browser origins.
NIE_ENV=development
NIE_TRUSTED_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Human owner identity verification. Use Firebase UID values, not emails or
# frontend role claims.
FIREBASE_PROJECT_ID=
NIE_OWNER_FIREBASE_UIDS=

# Opaque server-side Director browser session controls.
DIRECTOR_SESSION_TTL_SECONDS=1800
DIRECTOR_REALTIME_TICKET_TTL_SECONDS=45
DIRECTOR_SESSION_COOKIE_SECURE=false
DIRECTOR_SESSION_COOKIE_SAMESITE=lax

# Privileged server/CLI administration only. Never expose this to Vite.
NIE_OWNER_KEY=

# Self-hosted Director speech-to-text. PyAV (installed by faster-whisper)
# supplies bundled FFmpeg libraries; no provider key is required.
DIRECTOR_STT_PROVIDER=whisper
WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
# Render build command should populate this directory before the web process starts.
WHISPER_MODEL_CACHE_DIR=.cache/whisper
# Set true in production after scripts/cache_whisper_model.py succeeds at build time.
WHISPER_LOCAL_FILES_ONLY=false
WHISPER_INIT_TIMEOUT_SECONDS=45
WHISPER_TRANSCRIPTION_TIMEOUT_SECONDS=30
WHISPER_MAX_AUDIO_SECONDS=20
WHISPER_CPU_THREADS=1
WHISPER_BEAM_SIZE=1
WHISPER_TEMPERATURE=0
# Optional domain vocabulary. Keep short and validate against recorded speech.
WHISPER_INITIAL_PROMPT=
DIRECTOR_STT_MAX_AUDIO_BYTES=5242880
# Numeric-only audio ground-truth diagnostics. Off by default; never stores audio.
DIRECTOR_VOICE_DIAGNOSTICS=false

# Engineering Workspace. Production must use a persistent mounted directory
# and the Docker/remote isolated runner; local is development-only.
NIE_ENGINEERING_MODE_ENABLED=false
NIE_ENGINEERING_OWNER_ONLY=true
NIE_ENGINEERING_ALLOWED_FIREBASE_UIDS=
NIE_ENGINEERING_WORKSPACE_ROOT=storage/engineering_workspaces
NIE_ENGINEERING_RUNNER=local
NIE_ENGINEERING_RUNNER_IMAGE=napstertec-engineering-runner:local
NIE_ENGINEERING_MAX_FILE_BYTES=1000000
NIE_ENGINEERING_MAX_WORKSPACE_BYTES=100000000
NIE_ENGINEERING_MAX_FILE_COUNT=2000
NIE_ENGINEERING_MAX_OUTPUT_BYTES=100000
NIE_ENGINEERING_MAX_PROCESSES=2
NIE_ENGINEERING_MAX_CONCURRENT_EXECUTIONS=2
NIE_ENGINEERING_CPU_LIMIT=1
NIE_ENGINEERING_MEMORY_LIMIT=512m
NIE_ENGINEERING_PROCESS_LIMIT=128

# Vercel Sandbox runner (server-side only). Required when
# NIE_ENGINEERING_RUNNER=vercel_sandbox on a non-Vercel control plane.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
NIE_ENGINEERING_SANDBOX_IMAGE=vercel/sandbox/universal:latest
NIE_ENGINEERING_SANDBOX_SNAPSHOT_ID=
NIE_ENGINEERING_SANDBOX_TIMEOUT_SECONDS=300
NIE_ENGINEERING_SANDBOX_VCPUS=1
NIE_ENGINEERING_SANDBOX_MEMORY_MB=2048
NIE_ENGINEERING_SYNCHRONIZATION_TIMEOUT_SECONDS=60
NIE_ENGINEERING_CLEANUP_TIMEOUT_SECONDS=15
NIE_ENGINEERING_NETWORK_POLICY=deny_all
NIE_ENGINEERING_NETWORK_ALLOWLIST=
